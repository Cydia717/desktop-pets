{
  "name": "renderer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --base=./ && node scripts/add-csp.cjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --config electron-builder.yml --win portable --x64 --publish never",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "main": "electron/main.cjs",
  "description": "Windows desktop companion with a blue plush dinosaur",
  "author": "Cydia717",
  "license": "UNLICENSED"
}
